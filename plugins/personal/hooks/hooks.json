{
  "description": "Route Agent (subagent) calls to a model by task type (see skills/model-routing); save the repo-* skills config and suggest init-personal-skills after a plugin update.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/repo_skills_config.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_agent.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
